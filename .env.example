# ============================================================
# AUTOVESTAI — EXAMPLE ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to `.env` for local development.
# Never commit production credentials, API keys, private keys,
# wallet mnemonics, or real user information.

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

PORT=3000
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ADMIN_PATH=control-tower


# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autovestai?schema=public


# ------------------------------------------------------------
# REDIS
# ------------------------------------------------------------

# Local development: redis://localhost:6379
# Docker Compose API container: redis://redis:6379

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Fail application startup when Redis is unavailable.
REDIS_REQUIRED_ON_STARTUP=false


# ------------------------------------------------------------
# AUTHENTICATION & ADMINISTRATION
# ------------------------------------------------------------

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAILS=

JWT_SECRET=
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d


# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------

EMAIL_ENCRYPTION_SECRET=
HELMET_ENABLED=true


# ------------------------------------------------------------
# WALLET SECURITY
# ------------------------------------------------------------

# Never place real mnemonics or private keys in this file.
MASTER_SEED=
WALLET_MASTER_MNEMONIC=


# ------------------------------------------------------------
# BLOCKCHAIN PROVIDERS
# ------------------------------------------------------------

ETH_RPC_URL=https://eth.llamarpc.com
TRON_API_URL=https://api.trongrid.io
BSC_RPC_URL=https://bsc-dataseed.binance.org
BLOCKSTREAM_API_URL=https://blockstream.info/api

TRONGRID_API_KEY=
TRON_API_KEY=
ETHERSCAN_API_KEY=


# ------------------------------------------------------------
# TREASURY & DEPOSIT WALLETS
# ------------------------------------------------------------

TREASURY_MASTER_WALLET_ADDRESS=

MASTER_WALLET_TRC20=
MASTER_WALLET_ERC20=

DEPOSIT_WALLET_USDT_TRC20=
DEPOSIT_WALLET_USDT_ERC20=
DEPOSIT_WALLET_USDT_BEP20=

DEPOSIT_WALLET_BTC_BTC=
DEPOSIT_WALLET_ETH_ERC20=
DEPOSIT_WALLET_BNB_BEP20=


# ------------------------------------------------------------
# TREASURY CONFIGURATION
# ------------------------------------------------------------

TREASURY_ASSET=USDT
TREASURY_NETWORK=TRC20
TREASURY_EXPLORER_BASE_URL=https://tronscan.org/#/address/

TREASURY_MONITORING_MODE=manual
TREASURY_SNAPSHOT_STALE_HOURS=24
TREASURY_PENDING_WITHDRAWAL_WARNING_THRESHOLD=10000


# ------------------------------------------------------------
# RECONCILIATION
# ------------------------------------------------------------

TREASURY_RECONCILIATION_TOLERANCE=0.01
RECONCILIATION_TOLERANCE=1

RECONCILIATION_STALE_SNAPSHOT_HOURS=12
RECONCILIATION_HIGH_PENDING_WITHDRAWALS_THRESHOLD=1000
RECONCILIATION_APPROVED_OUTFLOW_THRESHOLD=1000

RECONCILIATION_ENABLE_SCHEDULED_RUNS=false
RECONCILIATION_SCHEDULE_INTERVAL_HOURS=12


# ------------------------------------------------------------
# EMAIL
# ------------------------------------------------------------

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com


# ------------------------------------------------------------
# MARKET DATA PROVIDERS
# ------------------------------------------------------------

COINGECKO_PROVIDER_ENABLED=true
BINANCE_PROVIDER_ENABLED=true
TWELVE_DATA_PROVIDER_ENABLED=true
FOREX_PROVIDER_ENABLED=true
YAHOO_PROVIDER_ENABLED=true

TWELVE_DATA_API_KEY=


# ------------------------------------------------------------
# REAL-TIME MARKET DATA
# ------------------------------------------------------------

BINANCE_WS_URL=wss://stream.binance.com:9443/stream?streams=btcusdt@ticker/ethusdt@ticker

TWELVE_DATA_WEBSOCKET_SYMBOLS=EUR/USD,GBP/USD,XAU/USD,SPX,NDX,CL1!,XAG/USD,GBP/JPY

XAU_BASE_PRICE=2300

PRICE_QUOTE_STALE_MS=15000
PRICE_RECONNECT_INITIAL_DELAY_MS=2000
PRICE_RECONNECT_MAX_DELAY_MS=30000


# ------------------------------------------------------------
# TRADING & RISK
# ------------------------------------------------------------

MAX_LEVERAGE=20


# ------------------------------------------------------------
# FRONTEND FEATURES
# ------------------------------------------------------------

FRONTEND_TRADINGVIEW_ASSETS_ENABLED=false
